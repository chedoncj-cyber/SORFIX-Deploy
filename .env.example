# FIX_Aggregator_SOR_Complete APP — Environment Variables
# Copy this file to .env and fill in your values.
# The app loads .env automatically via python-dotenv.

# ── API Server ──────────────────────────────────────────────────────────────
APP_PORT=9090
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# ── Simulation mode ──────────────────────────────────────────────────────────
# Set to false only when live FIX socket connections are wired in execution_engine.py
SIMULATE=true

# ── GSE (Ghana Stock Exchange) FIX credentials ───────────────────────────────
GSE_HOST=fix.gse.com.gh
GSE_PORT=9876
GSE_SENDER_COMP_ID=BROKER_GH
GSE_TARGET_COMP_ID=GSE_TRADING
GSE_USERNAME=
GSE_PASSWORD=

# ── JSE (Johannesburg Stock Exchange) FIX credentials ────────────────────────
JSE_HOST=fix.jse.co.za
JSE_PORT=9877
JSE_SENDER_COMP_ID=BROKER_ZA
JSE_TARGET_COMP_ID=JSE_TRADING
JSE_USERNAME=
JSE_PASSWORD=

# ── NGX (Nigerian Exchange Group) FIX credentials ────────────────────────────
NGX_HOST=fix.ngxgroup.com
NGX_PORT=9878
NGX_SENDER_COMP_ID=BROKER_NG
NGX_TARGET_COMP_ID=NGX_TRADING
NGX_USERNAME=
NGX_PASSWORD=

# ── NSE (Nairobi Securities Exchange) FIX credentials ────────────────────────
NSE_HOST=fix.nse.co.ke
NSE_PORT=9879
NSE_SENDER_COMP_ID=BROKER_KE
NSE_TARGET_COMP_ID=NSE_TRADING
NSE_USERNAME=
NSE_PASSWORD=

# ── Kafka (optional — set use_kafka=true in sor_config.yaml to enable) ───────
KAFKA_BROKERS=kafka:9092

# ── PAPSS FX API (optional — replace mock rates in fx_optimizer.py) ──────────
PAPSS_API_KEY=
PAPSS_API_URL=
